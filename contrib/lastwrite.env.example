# Copy to /etc/lastwrite/env and restrict it: chmod 600 /etc/lastwrite/env

# Slack, Discord or any endpoint that accepts a JSON POST.
LASTWRITE_WEBHOOK_URL=

# Telegram needs both values.
LASTWRITE_TELEGRAM_TOKEN=
LASTWRITE_TELEGRAM_CHAT_ID=

# Defaults: poll every 4 hours, alert above 55C.
#LASTWRITE_INTERVAL_SECONDS=14400
#LASTWRITE_TEMP_LIMIT=55
